generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carrito {
  id_carrito                 BigInt                 @id @default(autoincrement())
  id_cliente                 Int?
  id_sesion                  Int?
  id_politica_envio          Int?
  id_promocion               Int?
  fecha_creacion             DateTime               @default(now()) @db.Timestamp(6)
  fecha_ultima_actualizacion DateTime               @default(now()) @db.Timestamp(6)
  subtotal                   Decimal                @default(0) @db.Decimal(10, 2)
  descuento                  Decimal                @default(0) @db.Decimal(10, 2)
  costo_envio                Decimal                @default(0) @db.Decimal(10, 2)
  total                      Decimal                @default(0) @db.Decimal(10, 2)
  estado_carrito             String                 @default("activo") @db.VarChar(20)
  cliente                    cliente?               @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  politica_envio             politica_envio?        @relation(fields: [id_politica_envio], references: [id_politica_envio], onDelete: NoAction, onUpdate: NoAction)
  promocion                  promocion?             @relation(fields: [id_promocion], references: [id_promocion], onDelete: NoAction, onUpdate: NoAction)
  sesion                     sesion?                @relation(fields: [id_sesion], references: [id_sesion], onDelete: NoAction, onUpdate: NoAction)
  carrito_abandono           carrito_abandono?
  detalle_carrito            detalle_carrito[]
  etapa_checkout             etapa_checkout[]
  intento_pago               intento_pago[]
  notificacion_carrito       notificacion_carrito[]
  pedido                     pedido?
  ticket_soporte             ticket_soporte[]

  @@index([id_cliente], map: "idx_carrito_cliente")
  @@index([estado_carrito], map: "idx_carrito_estado")
  @@index([fecha_creacion], map: "idx_carrito_fecha_creacion")
}

model carrito_abandono {
  id_carrito      BigInt   @id
  fecha_abandono  DateTime @default(now()) @db.Timestamp(6)
  motivo_abandono String?  @db.VarChar(200)
  carrito         carrito  @relation(fields: [id_carrito], references: [id_carrito], onDelete: Cascade, onUpdate: NoAction)
}

model catalogo_error_pago {
  id_catalogo_error  Int                  @id @default(autoincrement())
  codigo             String               @unique @db.VarChar(20)
  mensaje_tecnico    String               @db.VarChar(200)
  mensaje_cliente    String               @db.VarChar(300)
  intento_pago_error intento_pago_error[]
}

model categoria {
  id_categoria        Int        @id @default(autoincrement())
  nombre_categoria    String     @unique @db.VarChar(100)
  descripcion         String?
  estado              String     @default("activa") @db.VarChar(20)
  atributos_plantilla Json?      @default("[]")
  producto            producto[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cliente {
  id_cliente       Int               @id @default(autoincrement())
  correo           String            @unique @db.VarChar(150)
  password_hash    String            @db.VarChar(255)
  telefono         String?           @db.VarChar(20)
  tipo_persona     String            @db.VarChar(10)
  fecha_registro   DateTime          @default(now()) @db.Timestamp(6)
  estado           String            @default("activo") @db.VarChar(20)
  carrito          carrito[]
  cliente_juridico cliente_juridico?
  cliente_natural  cliente_natural?
  direccion        direccion[]
  pedido           pedido[]
  sesion           sesion[]
  ticket_soporte   ticket_soporte[]

  @@index([correo], map: "idx_cliente_correo")
}

model cliente_juridico {
  id_cliente       Int     @id
  razon_social     String  @db.VarChar(200)
  nombre_comercial String? @db.VarChar(200)
  nit              String  @unique @db.VarChar(20)
  nrc              String? @db.VarChar(20)
  giro             String? @db.VarChar(150)
  nombre_contacto  String? @db.VarChar(150)
  cliente          cliente @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade, onUpdate: NoAction)
}

model cliente_natural {
  id_cliente            Int                    @id
  nombres               String                 @db.VarChar(100)
  apellidos             String                 @db.VarChar(100)
  id_tipo_documento     Int
  numero_documento      String                 @db.VarChar(30)
  fecha_nacimiento      DateTime?              @db.Date
  cliente               cliente                @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade, onUpdate: NoAction)
  tipo_documento        tipo_documento         @relation(fields: [id_tipo_documento], references: [id_tipo_documento], onDelete: NoAction, onUpdate: NoAction)
  contribuyente_natural contribuyente_natural?

  @@unique([id_tipo_documento, numero_documento])
}

model contribuyente_natural {
  id_cliente      Int             @id
  nrc             String          @db.VarChar(20)
  giro            String          @db.VarChar(150)
  cliente_natural cliente_natural @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model correlativo_documento {
  id_correlativo Int       @id @default(autoincrement())
  tipo_dte       String    @db.VarChar(30)
  serie          String    @db.VarChar(10)
  anio           Int
  id_sucursal    Int
  ultimo_numero  BigInt    @default(0)
  numero_maximo  BigInt    @default(99999999)
  estado         String    @default("activo") @db.VarChar(20)
  sucursal       sucursal  @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)
  factura        factura[]

  @@unique([tipo_dte, serie, id_sucursal, anio])
}

model departamento {
  id_departamento Int         @id @default(autoincrement())
  id_pais         Int
  nombre          String      @db.VarChar(100)
  pais            pais        @relation(fields: [id_pais], references: [id_pais], onDelete: NoAction, onUpdate: NoAction)
